# Copy to .env and adjust for your environment.
# All settings are prefixed FEASTSTORE_.

FEASTSTORE_OFFLINE_DSN=postgresql+psycopg://feaststore:feaststore@localhost:5432/feaststore
FEASTSTORE_ONLINE_REDIS_URL=redis://localhost:6379/0
FEASTSTORE_PROJECT=default
FEASTSTORE_LOG_LEVEL=INFO
FEASTSTORE_ENABLE_METRICS=true
